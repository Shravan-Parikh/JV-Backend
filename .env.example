# Local: the API on 4100 and the web app on 3100, so both can run alongside the
# CS Dashboard (4000 / 3000) without a port clash.
PORT=4100
CORS_ORIGIN=http://localhost:3100

# Firebase. The web API key is public by design — access is governed by the
# Firestore rules, not by this key. While JV shares a project with the CS
# Dashboard these are the same two values that app uses.
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=

# Accounts are provisioned with scripts/create-user.js, never self-served.
ALLOW_PUBLIC_SIGNUP=false
ADMIN_EMAILS=

# Default GST rate on job-work billing, overridable per client and per entry.
DEFAULT_GST_RATE=5

# Collection prefix. Keeps JV's data clear of the app sharing this Firebase
# project. Set to an empty value once JV has a project of its own.
JV_COLLECTION_PREFIX=jv_
